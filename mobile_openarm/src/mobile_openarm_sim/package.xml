<?xml version="1.0"?>
<package format="3">
  <name>mobile_openarm_sim</name>
  <version>0.1.0</version>
  <description>MuJoCo simulation of OpenArm v1 bimanual upper body on a differential-drive wheeled base, with a ROS 2 Jazzy bridge (clock, joint_states, odom, scan, imu, ArUco, FollowJointTrajectory).</description>
  <maintainer email="user@example.com">student</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- mujoco 파이썬 패키지는 rosdep 키가 없어 pip 로 설치 (문서 3장) -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
