<!-- 자동 생성: tools/make_srdf.py -->
<robot name="tron1_openarm">
  <group name="left_arm">
    <chain base_link="openarm_left_link0" tip_link="openarm_left_hand_tcp" />
  </group>
  <group name="right_arm">
